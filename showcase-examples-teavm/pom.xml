<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>gwt-material-widgets-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <properties>
    <!-- Not a published library. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <artifactId>gwt-material-showcase-examples-teavm</artifactId>
  <dependencies><dependency><groupId>io.instanto</groupId><artifactId>gwt-material-table-teavm</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.instanto</groupId><artifactId>gwt-material-addins-teavm</artifactId><version>${project.version}</version></dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>gwt-material-widgets-teavm</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <resources><resource><directory>${project.build.directory}/generated-sources/patterns</directory></resource><resource><directory>${project.build.directory}</directory><targetPath>META-INF</targetPath><includes><include>pattern-inputs.sha256</include></includes></resource><resource><directory>../target/intake/patterns</directory><targetPath>META-INF/upstream/patterns</targetPath><includes><include>LICENSE*</include></includes></resource>
      <resource><directory>../showcase-teavm/src/site/licenses</directory><targetPath>META-INF/licenses</targetPath></resource>
 <resource><directory>${project.build.directory}/generated-sources/table-showcase</directory></resource>
 <resource><directory>../target/intake/table-demo/src/main/resources</directory></resource>
 <resource><directory>../target/intake/table-demo</directory><targetPath>META-INF/upstream/table-showcase</targetPath><includes><include>LICENSE*</include></includes></resource>
 <resource><directory>${project.build.directory}</directory><targetPath>META-INF</targetPath><includes><include>table-showcase-inputs.sha256</include></includes></resource>

      <resource><directory>../target/intake/addins-demo</directory><targetPath>META-INF/upstream/addins-showcase</targetPath><includes><include>LICENSE*</include></includes></resource>
      <resource><directory>${project.build.directory}</directory><targetPath>META-INF</targetPath><includes><include>addins-showcase-inputs.sha256</include></includes></resource>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/java</directory>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated-sources/showcase</directory>
      </resource>
      <resource>
        <directory>${project.build.directory}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>showcase-inputs.sha256</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><configuration><proc>full</proc><annotationProcessorPaths><path><groupId>io.instanto</groupId><artifactId>gwt-uibinder-processor</artifactId><version>${gwt-uibinder-processor.version}</version></path></annotationProcessorPaths></configuration></plugin>
      <plugin>
        <groupId>io.instanto</groupId>
        <artifactId>gwt-material-build-maven-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>showcase-sources</goal>
            </goals>
          </execution>
          <execution><id>addins-showcase</id><goals><goal>addins-showcase-sources</goal></goals><configuration><input>${project.basedir}/../target/intake/addins-demo</input></configuration></execution><execution><id>patterns</id><goals><goal>pattern-sources</goal></goals><configuration><input>${project.basedir}/../target/intake/patterns</input></configuration></execution><execution><id>table-showcase</id><goals><goal>table-showcase-sources</goal></goals><configuration><input>${project.basedir}/../target/intake/table-demo</input></configuration></execution><execution><id>teavm-shell</id><goals><goal>teavm-sources</goal></goals><configuration><input>${project.basedir}/../showcase-shared/src/main/java</input><output>${project.build.directory}/generated-sources/shell</output></configuration></execution>
        </executions>
        <configuration>
          <input>${project.basedir}/../target/intake/showcase</input>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
