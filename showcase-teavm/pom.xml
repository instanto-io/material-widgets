<project xmlns='http://maven.apache.org/POM/4.0.0'>
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>gwt-material-widgets-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>gwt-material-showcase-teavm</artifactId>
  <dependencies><dependency><groupId>io.instanto</groupId><artifactId>gwt-material-showcase-examples-teavm</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.instanto</groupId><artifactId>gwt-material-widgets-teavm</artifactId><version>${project.version}</version></dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>gwt-user-compat</artifactId>
      <version>${gwt-user-compat.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>gwt-material-widgets-assets</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <phase>prepare-package</phase>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>io.instanto.material.client.MaterialTeaVm</mainClass>
          <targetDirectory>${project.build.directory}/site</targetDirectory>
          <targetFileName>showcase.js</targetFileName>
          <optimizationLevel>${teavm.optimization}</optimizationLevel>
          <minifying>${teavm.minify}</minifying>
          <sourceMapsGenerated>true</sourceMapsGenerated>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>site</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/site</outputDirectory>
              <overwrite>true</overwrite><resources><resource><directory>../showcase-examples-teavm/target/addins-site</directory></resource><resource><directory>../showcase-examples-teavm/target/pattern-site</directory></resource>
                <resource><directory>../showcase-shared/src/site</directory><excludes><exclude>index.html</exclude></excludes></resource>
                <resource><directory>../target/intake/showcase/src/main/webapp/images</directory><targetPath>images</targetPath></resource>
                <resource><directory>../target/intake/core/gwt-material/src/main/resources/gwt/material/design/public/font</directory><targetPath>material/font</targetPath></resource>
                <resource>
                  <directory>src/site</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>probe-assets</id>
            <phase>package</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.instanto</groupId>
                  <artifactId>gwt-material-widgets-assets</artifactId>
                  <version>${project.version}</version>
                  <outputDirectory>${project.build.directory}/site</outputDirectory>
                  <includes>META-INF/resources/gwt-material/**</includes>
                  <fileMappers>
                    <org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                      <pattern>^META-INF/resources/(.+)$</pattern>
                      <replacement>$1</replacement>
                    </org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                  </fileMappers>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>stage-pages</id>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions><execution>
          <id>stage-pages-on-main</id>
          <phase>verify</phase>
          <goals><goal>copy-resources</goal></goals>
          <configuration>
            <outputDirectory>${project.basedir}/../docs</outputDirectory>
            <overwrite>true</overwrite>
            <resources>
              <resource><directory>${project.build.directory}/site</directory></resource>
              <resource><directory>..</directory><includes><include>LICENSE</include><include>NOTICE</include></includes></resource>
            </resources>
          </configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
