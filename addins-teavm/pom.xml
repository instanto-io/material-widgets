<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>gwt-material-widgets-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>gwt-material-addins-teavm</artifactId>
  <name>Material Addins for TeaVM</name>
  <description>GWT Material Addins adapted for TeaVM, with their original widget packages and browser assets.</description>
  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>gwt-material-widgets-teavm</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated-resources/material</directory>
        <includes><include>gwt/material/design/addins/**</include></includes>
      </resource>
      <resource>
        <directory>..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
          <include>upstream/assessment-lock.json</include>
        </includes>
      </resource>
      <resource>
        <directory>../target/intake/addins</directory>
        <targetPath>META-INF/upstream</targetPath>
        <includes>
          <include>LICENSE*</include>
        </includes>
      </resource>
      <resource>
        <directory>${project.build.directory}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>teavm-inputs.sha256</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <proc>full</proc>
          <annotationProcessorPaths>
            <path>
              <groupId>io.instanto</groupId>
              <artifactId>gwt-uibinder-processor</artifactId>
              <version>${gwt-uibinder-processor.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>select-supported-addins</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/selected-sources</outputDirectory>
              <resources>
                <resource>
                  <directory>../target/intake/addins/src/main/java</directory>
                  <includes><include>gwt/material/design/addins/**/*.java</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.instanto</groupId>
        <artifactId>gwt-material-build-maven-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>teavm-sources</goal>
              <goal>material-resources</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <resourceInput>${project.basedir}/../target/intake/addins/src/main/resources</resourceInput>
          <input>${project.build.directory}/selected-sources</input>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
