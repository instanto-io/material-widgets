<project xmlns='http://maven.apache.org/POM/4.0.0'>
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>instanto-teavm-pom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>
  <groupId>io.instanto</groupId>
  <artifactId>gwt-material-widgets-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Material Widgets for TeaVM</name>
  <description>Independent TeaVM adaptation of GWT Material Design</description>
  <url>https://github.com/Instanto-io/material-widgets</url><scm>
    <url>https://github.com/instanto-io/material-widgets</url>
    <connection>scm:git:https://github.com/instanto-io/material-widgets.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/instanto-io/material-widgets.git</developerConnection>
    <tag>HEAD</tag>
  </scm>
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-09-08T10:00:00Z</project.build.outputTimestamp>
    <teavm-compat.version>0.1.0-SNAPSHOT</teavm-compat.version><jsinterop-binding-generator.version>${teavm-compat.version}</jsinterop-binding-generator.version>
    <gwt-uibinder-processor.version>${teavm-compat.version}</gwt-uibinder-processor.version>
    <gwt-user-compat.version>${teavm-compat.version}</gwt-user-compat.version>
    <teavm.optimization>SIMPLE</teavm.optimization>
    <teavm.minify>false</teavm.minify>
    <!-- The libraries publish. Showcases, probes and audits set this back to
         true in their own POMs. -->
    <maven.deploy.skip>false</maven.deploy.skip>
    <material-core.revision>d79f6edb813b263d2d97f51814abe6f1a8c88a2a</material-core.revision>
    <material-jquery.revision>a9a3755722a9552d86d90f322948867776286b16</material-jquery.revision>
    <material-addins-demo.revision>56687222967f45368ae5008357581d5b485cb0af</material-addins-demo.revision>
    <material-addins.revision>568eb3f92aa4317504887994cfb5dacebf850931</material-addins.revision>
    <gmd-core-demo.revision>63528c811e5e91a6bdbd5b523748d47251cc89f9</gmd-core-demo.revision>
  <!-- Fork of GwtMaterialDesign/gwt-material-table at 7cbce43, carrying two fixes:
       column toggle ids after reindexing, and restoring the body scrollbar when a
       stretched table is removed. -->
  <material-table.revision>a26ad6df1ad702e2e63b776070bf2cdf15d3e816</material-table.revision>
  <material-table-demo.revision>d5b7288cd7061f923a3d38469a4d69cb9505f58a</material-table-demo.revision>
  <material-patterns.revision>08f63dd686f72c27b06d2c7ef3abcb25b82308e1</material-patterns.revision>
</properties>

  <modules>
    <module>material-build</module>
    <module>material-compat-contracts</module>
    <module>material-assets</module>
    <module>jquery-teavm</module>
    <module>core-teavm</module>
    <module>addins-teavm</module>
    <module>table-teavm</module>
    <module>interop-teavm</module>
    <module>showcase-examples-teavm</module>
    <module>showcase-teavm</module>
  </modules>
  <!-- Fixed versions use this repository's GitHub Packages registry. Development
       snapshots inherit packages.instanto.io from the organisation parent. -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/instanto-io/material-widgets</url>
    </repository>
  </distributionManagement>
  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.43.0</version>
        <inherited>false</inherited>
        <configuration>
          <java>
            <includes>
              <include>*/src/main/java/**/*.java</include>
              <include>*/src/test/java/**/*.java</include>
              <include>examples/*/src/main/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>1.35.0</version>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <phase>validate</phase>
            <goals>
              <goal>apply</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.github.download-maven-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <version>2.0.0</version>
        <inherited>false</inherited>
        <executions><execution>
 <id>fetch-pinned-core</id><phase>initialize</phase><goals><goal>wget</goal></goals>
 <configuration><uri>https://codeload.github.com/GwtMaterialDesign/gwt-material/zip/${material-core.revision}</uri>
 <outputDirectory>${project.build.directory}/upstream</outputDirectory><outputFileName>gwt-material.zip</outputFileName><readTimeOut>30000</readTimeOut></configuration>
</execution>
<execution>
 <id>fetch-pinned-jquery</id><phase>initialize</phase><goals><goal>wget</goal></goals>
 <configuration><uri>https://codeload.github.com/GwtMaterialDesign/gwt-material-jquery/zip/${material-jquery.revision}</uri>
 <outputDirectory>${project.build.directory}/upstream</outputDirectory><outputFileName>gwt-material-jquery.zip</outputFileName><readTimeOut>30000</readTimeOut></configuration>
</execution><execution>
 <id>fetch-pinned-core-demo</id><phase>initialize</phase><goals><goal>wget</goal></goals>
 <configuration><uri>https://codeload.github.com/GwtMaterialDesign/gmd-core-demo/zip/${gmd-core-demo.revision}</uri>
 <outputDirectory>${project.build.directory}/upstream</outputDirectory><outputFileName>gmd-core-demo.zip</outputFileName><readTimeOut>30000</readTimeOut></configuration>
</execution>
<execution>
 <id>fetch-pinned-addins-demo</id><phase>initialize</phase><goals><goal>wget</goal></goals>
 <configuration><uri>https://codeload.github.com/GwtMaterialDesign/gwt-material-demo/zip/${material-addins-demo.revision}</uri>
 <outputDirectory>${project.build.directory}/upstream</outputDirectory><outputFileName>gwt-material-addins-demo.zip</outputFileName><readTimeOut>30000</readTimeOut></configuration>
</execution>
<execution>
          <id>fetch-pinned-addins</id><phase>initialize</phase><goals><goal>wget</goal></goals>
          <configuration>
            <uri>https://codeload.github.com/GwtMaterialDesign/gwt-material-addins/zip/${material-addins.revision}</uri>
            <outputDirectory>${project.build.directory}/upstream</outputDirectory>
            <outputFileName>gwt-material-addins.zip</outputFileName>
            <readTimeOut>30000</readTimeOut>
          </configuration>
        </execution>
<execution>
          <id>fetch-pinned-table</id><phase>initialize</phase><goals><goal>wget</goal></goals>
          <configuration>
            <uri>https://codeload.github.com/cstainton/gwt-material-table/zip/${material-table.revision}</uri>
            <outputDirectory>${project.build.directory}/upstream</outputDirectory>
            <outputFileName>gwt-material-table.zip</outputFileName>
            <readTimeOut>30000</readTimeOut>
          </configuration>
        </execution>
<execution>
          <id>fetch-pinned-table-demo</id><phase>initialize</phase><goals><goal>wget</goal></goals>
          <configuration>
            <uri>https://codeload.github.com/GwtMaterialDesign/gmd-table-demo/zip/${material-table-demo.revision}</uri>
            <outputDirectory>${project.build.directory}/upstream</outputDirectory>
            <outputFileName>gmd-table-demo.zip</outputFileName>
            <readTimeOut>30000</readTimeOut>
          </configuration>
        </execution><execution><id>fetch-pinned-patterns</id><phase>initialize</phase><goals><goal>wget</goal></goals>
<configuration>
<uri>https://codeload.github.com/GwtMaterialDesign/gwt-material-patterns/zip/${material-patterns.revision}</uri>
<outputDirectory>${project.build.directory}/upstream</outputDirectory>
<outputFileName>gwt-material-patterns.zip</outputFileName><readTimeOut>30000</readTimeOut>
</configuration></execution>
</executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <inherited>false</inherited>
        <executions>
          <execution>
            <id>pinned-source-intake</id>
            <phase>initialize</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <delete dir='${project.build.directory}/intake'/>
<unzip src='${project.build.directory}/upstream/gwt-material-table.zip' dest='${project.build.directory}/intake/table'>
  <mapper type='glob' from='gwt-material-table-${material-table.revision}/*' to='*'/>
</unzip>
<unzip src='${project.build.directory}/upstream/gmd-table-demo.zip' dest='${project.build.directory}/intake/table-demo'>
  <mapper type='glob' from='gmd-table-demo-${material-table-demo.revision}/*' to='*'/>
</unzip>

<unzip src='${project.build.directory}/upstream/gwt-material-patterns.zip' dest='${project.build.directory}/intake/patterns'>
<mapper type='glob' from='gwt-material-patterns-${material-patterns.revision}/*' to='*'/>
</unzip>
                <unzip src='${project.build.directory}/upstream/gwt-material.zip' dest='${project.build.directory}/intake/core'>
                  <mapper type='glob' from='gwt-material-${material-core.revision}/*' to='*'/>
                </unzip>
                <unzip src='${project.build.directory}/upstream/gwt-material-jquery.zip' dest='${project.build.directory}/intake/jquery'>
                  <mapper type='glob' from='gwt-material-jquery-${material-jquery.revision}/*' to='*'/>
                </unzip>
                <unzip src='${project.build.directory}/upstream/gmd-core-demo.zip' dest='${project.build.directory}/intake/showcase'>
                  <mapper type='glob' from='gmd-core-demo-${gmd-core-demo.revision}/*' to='*'/>
                </unzip>
                <unzip src='${project.build.directory}/upstream/gwt-material-addins-demo.zip' dest='${project.build.directory}/intake/addins-demo'><mapper type='glob' from='gwt-material-demo-${material-addins-demo.revision}/*' to='*'/></unzip>
                <unzip src='${project.build.directory}/upstream/gwt-material-addins.zip' dest='${project.build.directory}/intake/addins'>
                  <mapper type='glob' from='gwt-material-addins-${material-addins.revision}/*' to='*'/>
                </unzip>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>artifacts</id>
      <distributionManagement>
        <repository>
          <id>artifacts</id>
          <url>https://artifacts.instanto.io/repository/maven-releases/</url>
        </repository>
      </distributionManagement>
    </profile>
    <profile>
      <id>showcase-tests</id>
      <modules><module>showcase-tests</module></modules>
    </profile>
    <profile>
      <id>production</id>
      <properties>
        <teavm.optimization>ADVANCED</teavm.optimization>
        <teavm.minify>true</teavm.minify>
      </properties>
    </profile>
    <profile>
      <id>compatibility-audit</id>
      <modules>
        <module>compatibility-audit</module>
      </modules>
    </profile>
    <profile>
      <id>native-gwt-baseline</id>
      <modules>
        <module>gwt-api-browser-baseline</module>
      </modules>
    </profile>
  </profiles>
</project>
